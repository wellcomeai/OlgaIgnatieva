# ===== DATABASE =====
DATABASE_URL=postgresql+asyncpg://opensaas:password@localhost:5432/opensaas_db
# SSL к БД (true для managed PostgreSQL, false для postgres в Docker рядом)
DATABASE_SSL=true

# Используются только в docker-compose.prod.yml для контейнера postgres
POSTGRES_DB=opensaas_db
POSTGRES_USER=opensaas
POSTGRES_PASSWORD=password

# ===== REDIS (опционально) =====
# Если не задан — используется PostgreSQL fallback
# Для включения раскомментировать:
# REDIS_URL=redis://localhost:6379

# ===== JWT =====
SECRET_KEY=your-secret-key-minimum-32-characters-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== ADMIN (создаётся при первом запуске) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_in_production

# ===== SMTP EMAIL =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=VisaNews2U
SMTP_USE_TLS=true

# ===== РОБОКАССА =====
ROBOKASSA_MERCHANT_LOGIN=your_merchant_login
ROBOKASSA_PASSWORD1=your_password1
ROBOKASSA_PASSWORD2=your_password2
ROBOKASSA_TEST_MODE=true
# Чек 54-ФЗ в ссылке на оплату (если касса не берёт номенклатуру из настроек магазина)
ROBOKASSA_RECEIPT_ENABLED=false
ROBOKASSA_TAX=none
ROBOKASSA_SNO=
ROBOKASSA_PAYMENT_OBJECT=service
# В кабинете Робокассы (Технические настройки):
#   Result URL  = https://<домен>/api/v1/webhooks/robokassa  (метод POST)
#   Success URL = https://<домен>/pay/success                (метод GET)
#   Fail URL    = https://<домен>/pay/fail                   (метод GET)

# === ПЛАНЫ ПОДПИСКИ ===
PLAN_BASIC_NAME=Basic
PLAN_BASIC_PRICE=990
PLAN_BASIC_INTERVAL=month
PLAN_BASIC_FEATURES=До 100 запросов в день,Email поддержка,Базовая аналитика

PLAN_PRO_NAME=Pro
PLAN_PRO_PRICE=2990
PLAN_PRO_INTERVAL=month
PLAN_PRO_FEATURES=Безлимит запросов,Приоритетная поддержка,API доступ,Расширенная аналитика

# ===== STRIPE (заготовка, не активен) =====
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_ENABLED=false

# ===== APP =====
APP_NAME=VisaNews2U
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# ===== ДОСТУП =====
# Регистрация закрыта: владелец входит под ADMIN_EMAIL / ADMIN_PASSWORD
REGISTRATION_ENABLED=false

# ===== ФАЙЛЫ ПРОДУКТОВ =====
# Папка для загруженных файлов (в Docker — постоянный том /data/media)
MEDIA_ROOT=media

# ===== TELEGRAM =====
# Публичный HTTPS-адрес для вебхуков ботов (пусто → APP_URL).
# Telegram принимает только https://, на localhost вебхук не настроится.
TELEGRAM_WEBHOOK_BASE_URL=
# Ключ шифрования токенов ботов (пусто → выводится из SECRET_KEY).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOT_TOKEN_ENCRYPTION_KEY=

# ===== БИЗНЕС ЛОГИКА =====
TRIAL_DAYS=3
REFERRAL_COMMISSION_PERCENT=20


# ===== LOCAL DOCKER =====
# DATABASE_URL уже переопределён в docker-compose.local.yml
# Менять не нужно
